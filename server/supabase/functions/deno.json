{
	"tasks": {
		"check": "deno check --frozen */index.ts && deno lint . && deno fmt --check ."
	},
	"compilerOptions": {
		"strict": true
	},
	"lint": {
		"exclude": ["main/"],
		"rules": {
			"exclude": ["no-import-prefix"]
		}
	},
	"fmt": {
		"lineWidth": 100,
		"useTabs": true,
		"singleQuote": true,
		"semiColons": false,
		"exclude": ["main/"]
	}
}
