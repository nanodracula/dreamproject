# Operator configuration for tools/supabase/*.sh. Copy to server/.env.local
# (gitignored) and fill in the values; see server/README.md.

# --- Remote Postgres (through the SSH tunnel) ---
# Use postgres.<POOLER_TENANT_ID> for Supavisor, or postgres for direct Postgres.
SUPABASE_DB_USER=
POSTGRES_PASSWORD=

# --- Infrastructure identifiers ---
# SSH host alias or user@host for the VPS running the Dokploy stack.
SUPABASE_SSH_HOST=
# Supavisor container name; the tunnel forwards to its port 5432.
SUPABASE_REMOTE_CONTAINER=
# Edge functions container name, stopped and started during a functions deploy.
SUPABASE_FUNCTIONS_CONTAINER=
# Absolute path of the functions volume on the VPS (the active release directory).
SUPABASE_FUNCTIONS_DIR=
SUPABASE_TUNNEL_PORT=54330
